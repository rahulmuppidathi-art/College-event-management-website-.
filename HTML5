const LB=[["Tech Club",940],["Music Society",820],["Robotics Club",760],["Gaming Guild",610],["Design Society",540]];
$("#lb").innerHTML=LB.map((l,i)=>`<div class="lb"><b>${i+1}</b><span style="width:8.5rem">${l[0]}</span><div class="bar"><i style="width:${l[1]/9.4}%"></i></div><b>${l[1]}</b></div>`).join("");

/* countdown + counters */
const T=new Date("2026-12-12T09:00:00+05:30");
function tick(){let s=Math.max(0,Math.floor((T-Date.now())/1e3));const v=[["Days",86400],["Hours",3600],["Mins",60],["Secs",1]];
  $("#cd").innerHTML=v.map(([l,k])=>{const n=Math.floor(s/k);s%=k;return `<div><b>${String(n).padStart(2,"0")}</b><small>${l}</small></div>`}).join("")}
tick();setInterval(tick,1000);
$$("[data-n]").forEach(el=>{const to=+el.dataset.n,p=el.dataset.p||"",s=el.dataset.s||"";let st=null;
  const go=t=>{st=st||t;const k=Math.min(1,(t-st)/1400),n=Math.round(to*(1-Math.pow(1-k,3)));el.textContent=p+n.toLocaleString("en-IN")+s;if(k<1)requestAnimationFrame(go)};requestAnimationFrame(go)});
$("#prop").onclick=()=>{location.href="mailto:events@campuspulse.edu?subject=Event%20Proposal%20for%20Pulse%202026"};
draw();tkList();

/* confetti */
function confetti(){const c=document.createElement("canvas");c.style.cssText="position:fixed;inset:0;pointer-events:none;z-index:150";c.width=innerWidth;c.height=innerHeight;document.body.append(c);
  const x=c.getContext("2d"),P=Array.from({length:110},()=>({x:innerWidth/2,y:innerHeight/2,vx:(Math.random()-.5)*14,vy:Math.random()*-13-2,c:["#22d3ee","#6366f1","#a855f7","#fff"][Math.random()*4|0],s:Math.random()*6+3}));let f=0;
  (function a(){x.clearRect(0,0,c.width,c.height);P.forEach(p=>{p.x+=p.vx;p.y+=p.vy;p.vy+=.35;x.fillStyle=p.c;x.fillRect(p.x,p.y,p.s,p.s)});if(++f<110)requestAnimationFrame(a);else c.remove()})()}
</script>
