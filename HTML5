<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CampusPulse – Pulse 2026 College Fest Portal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#0a0b10;--ind:#6366f1;--cy:#22d3ee;--vi:#a855f7;--tx:#e8eaf6;--mu:#8b90ad;--gl:rgba(255,255,255,.05);--bd:rgba(255,255,255,.1);--g:linear-gradient(110deg,var(--cy),var(--ind) 50%,var(--vi))}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth;scroll-padding-top:80px}
body{font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;background:var(--bg);color:var(--tx);line-height:1.6;overflow-x:hidden;
background-image:radial-gradient(600px 400px at 85% -5%,rgba(99,102,241,.28),transparent),radial-gradient(500px 400px at 5% 30%,rgba(168,85,247,.16),transparent)}
a{color:inherit;text-decoration:none}
button,input,select{font:inherit;color:inherit}
.gt{background:var(--g);-webkit-background-clip:text;background-clip:text;color:transparent}
.wrap{max-width:1180px;margin:auto;padding:0 1.2rem}
section{padding:3.5rem 0}
h2{font-size:clamp(1.6rem,4vw,2.3rem);font-weight:800;letter-spacing:-.02em;margin-bottom:.4rem}
.sub{color:var(--mu);margin-bottom:1.6rem}
:focus-visible{outline:2px solid var(--cy);outline-offset:2px}
/* nav */
nav{position:sticky;top:0;z-index:50;background:rgba(10,11,16,.6);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid var(--bd)}
.nb{display:flex;align-items:center;gap:1.2rem;height:66px}
.logo{font-weight:800;font-size:1.2rem;display:flex;align-items:center;gap:.5rem}
.dot{width:10px;height:10px;border-radius:50%;background:var(--cy);box-shadow:0 0 12px var(--cy);animation:pulse 1.8s infinite}
@keyframes pulse{50%{transform:scale(1.6);opacity:.5}}
.links{display:flex;gap:1.1rem;margin-left:auto;font-size:.9rem;color:var(--mu)}
.links a:hover{color:var(--tx)}
.sr{position:relative}
.sr input{background:var(--gl);border:1px solid var(--bd);border-radius:10px;padding:.5rem 3.4rem .5rem .8rem;width:200px}
.sr kbd{position:absolute;right:8px;top:7px;font-size:.7rem;border:1px solid var(--bd);border-radius:5px;padding:0 .35rem;color:var(--mu)}
.btn{border:0;border-radius:11px;padding:.65rem 1.2rem;font-weight:600;cursor:pointer;transition:.25s;display:inline-block;text-align:center}
.pri{background:var(--g);color:#fff;box-shadow:0 0 0 rgba(99,102,241,0)}
.pri:hover{box-shadow:0 0 28px rgba(99,102,241,.7);transform:translateY(-2px)}
.gh{background:var(--gl);border:1px solid var(--bd)}
.gh:hover{border-color:var(--cy);box-shadow:0 0 18px rgba(34,211,238,.25)}
/* hero */
.hero{padding:4.5rem 0 2.5rem}
.hero h1{font-size:clamp(2.3rem,7vw,4.6rem);line-height:1.05;font-weight:800;letter-spacing:-.035em;max-width:15ch}
.hero p{color:var(--mu);max-width:56ch;margin:1.1rem 0 1.6rem;font-size:1.08rem}
.cta{display:flex;gap:.8rem;flex-wrap:wrap}
.cd{display:flex;gap:.7rem;margin:2rem 0 1.2rem;flex-wrap:wrap;align-items:center}
.cd div{background:var(--gl);border:1px solid var(--bd);backdrop-filter:blur(10px);border-radius:14px;padding:.6rem 1rem;text-align:center;min-width:76px}
.cd b{display:block;font-size:1.8rem;font-variant-numeric:tabular-nums}
.cd small,.cdl{color:var(--mu);font-size:.75rem}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:.8rem;margin-top:1.4rem}
.stats div{border-left:2px solid var(--ind);padding-left:.9rem}
.stats b{font-size:1.9rem;font-weight:800}
.stats span{display:block;color:var(--mu);font-size:.85rem}
/* filters */
.fb{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin-bottom:1.4rem}
.chip{background:var(--gl);border:1px solid var(--bd);border-radius:99px;padding:.4rem .95rem;cursor:pointer;font-size:.88rem;transition:.2s}
.chip:hover{border-color:var(--cy)}
.chip.on{background:var(--g);border-color:transparent;color:#fff}
.sw{margin-left:auto;display:flex;align-items:center;gap:.6rem;font-size:.88rem;color:var(--mu);cursor:pointer}
.sw input{display:none}
.sw i{width:42px;height:24px;background:#2a2d40;border-radius:99px;position:relative;transition:.25s}
.sw i::after{content:"";position:absolute;width:18px;height:18px;border-radius:50%;background:#fff;top:3px;left:3px;transition:.25s}
.sw input:checked+i{background:var(--ind)}
.sw input:checked+i::after{left:21px}
/* cards */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1.2rem}
.card{--mx:50%;--my:50%;position:relative;background:var(--gl);border:1px solid var(--bd);border-radius:20px;padding:1.3rem;display:flex;flex-direction:column;gap:.6rem;backdrop-filter:blur(12px);transition:transform .15s,border-color .3s,box-shadow .3s;transform-style:preserve-3d;overflow:hidden}
.card::before{content:"";position:absolute;inset:0;background:radial-gradient(260px circle at var(--mx) var(--my),rgba(99,102,241,.22),transparent 60%);opacity:0;transition:.3s;pointer-events:none}
.card:hover{border-color:rgba(34,211,238,.5);box-shadow:0 0 34px rgba(99,102,241,.25)}
.card:hover::before{opacity:1}
.pills{display:flex;gap:.4rem;flex-wrap:wrap}
.pill{font-size:.72rem;font-weight:600;padding:.15rem .6rem;border-radius:99px;border:1px solid var(--bd);background:rgba(255,255,255,.04)}
.pill.c{color:var(--cy);border-color:rgba(34,211,238,.4)}.pill.v{color:#d8b4fe;border-color:rgba(168,85,247,.4)}.pill.i{color:#a5b4fc;border-color:rgba(99,102,241,.5)}
.card h3{font-size:1.2rem;line-height:1.3}
.org{color:var(--mu);font-size:.85rem}
.meta{display:flex;gap:.9rem;flex-wrap:wrap;font-size:.84rem;color:var(--mu)}
.bar{height:7px;background:#20233a;border-radius:9px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--g);border-radius:9px}
.cap{display:flex;justify-content:space-between;font-size:.8rem;color:var(--mu)}
.acts{display:flex;gap:.6rem;margin-top:.4rem}
.acts .btn{flex:1;padding:.55rem .6rem;font-size:.9rem}
.btn[disabled]{opacity:.45;cursor:not-allowed;box-shadow:none;transform:none}
.none{color:var(--mu);padding:2rem 0}
/* schedule */
.tabs{display:flex;gap:.5rem;margin-bottom:1.2rem}
.tl{border-left:2px solid var(--bd);margin-left:.6rem;display:grid;gap:1rem}
.slot{position:relative;margin-left:1.4rem;background:var(--gl);border:1px solid var(--bd);border-radius:14px;padding:1rem 1.2rem;animation:fi .35s}
.slot::before{content:"";position:absolute;left:-1.95rem;top:1.3rem;width:12px;height:12px;border-radius:50%;background:var(--ind);box-shadow:0 0 12px var(--ind)}
.slot time{color:var(--cy);font-weight:600;font-size:.85rem}
.slot h4{font-size:1.05rem}
@keyframes fi{from{opacity:0;transform:translateY(8px)}}
/* lb + tickets */
.two{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.2rem}
.panel{background:var(--gl);border:1px solid var(--bd);border-radius:20px;padding:1.3rem;backdrop-filter:blur(12px)}
.lb{display:flex;align-items:center;gap:.8rem;padding:.55rem 0;border-bottom:1px solid var(--bd)}
.lb:last-child{border:0}
.lb b:first-child{width:1.6rem;color:var(--cy)}
.lb .bar{flex:1}
.tk{display:flex;justify-content:space-between;align-items:center;gap:.6rem;padding:.6rem 0;border-bottom:1px solid var(--bd);font-size:.9rem}
/* modal */
.ov{position:fixed;inset:0;background:rgba(5,6,10,.7);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);display:grid;place-items:center;padding:1rem;z-index:100;opacity:0;pointer-events:none;transition:.25s}
.ov.open{opacity:1;pointer-events:auto}
.md{background:#12131d;border:1px solid var(--bd);border-radius:22px;width:min(560px,100%);max-height:92vh;overflow:auto;padding:1.6rem;transform:translateY(20px) scale(.97);transition:.3s;box-shadow:0 0 60px rgba(99,102,241,.25)}
.ov.open .md{transform:none}
.md h3{font-size:1.4rem;margin-bottom:.8rem}
.x{float:right;background:none;border:0;font-size:1.5rem;cursor:pointer;color:var(--mu)}
form{display:grid;gap:.8rem}
label{display:grid;gap:.25rem;font-size:.84rem;color:var(--mu)}
input:not([type=checkbox]):not([type=radio]),select{background:rgba(255,255,255,.05);border:1px solid var(--bd);border-radius:10px;padding:.6rem .75rem;color:var(--tx);width:100%}
select option{background:#12131d}
input:invalid:not(:placeholder-shown){border-color:#f87171}
.r2{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}
.mode{display:flex;gap:.6rem}
.mode label{flex:1;display:flex;align-items:center;gap:.4rem;border:1px solid var(--bd);border-radius:10px;padding:.5rem .7rem;cursor:pointer;color:var(--tx)}
.mode input{width:auto}
.pass{background:linear-gradient(135deg,#1b1e3a,#1a1030);border:1px solid rgba(99,102,241,.5);border-radius:18px;padding:1.2rem;display:flex;gap:1rem;align-items:center;flex-wrap:wrap;margin:1rem 0}
.pass svg{background:#fff;border-radius:10px;padding:6px;width:120px;height:120px}
.pass b{font-size:1.1rem}
.pass small{display:block;color:var(--mu)}
footer{border-top:1px solid var(--bd);padding:2.5rem 0 1.5rem;margin-top:2rem;color:var(--mu);font-size:.88rem}
.fg{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1.5rem}
footer h5{color:var(--tx);margin-bottom:.5rem}
footer a{display:block}footer a:hover{color:var(--cy)}
.st{display:flex;align-items:center;gap:.5rem;margin-top:1.5rem}
.toast{position:fixed;bottom:1.2rem;right:1.2rem;background:#12131d;border:1px solid var(--cy);padding:.7rem 1.1rem;border-radius:12px;z-index:200;transform:translateY(150%);transition:.3s}
.toast.on{transform:none}
@media(max-width:820px){.links{display:none}.sr{margin-left:auto}.sr input{width:140px}.r2{grid-template-columns:1fr}.nb .btn{padding:.55rem .8rem}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<nav><div class="wrap nb">
  <a class="logo" href="#top"><span class="dot"></span><span class="gt">CampusPulse</span></a>
  <div class="links"><a href="#events">Explore Events</a><a href="#events">Categories</a><a href="#schedule">Schedule</a><a href="#board">Leaderboard</a><a href="#tickets">My Tickets</a></div>
  <div class="sr"><input id="q" type="search" placeholder="Search events…" aria-label="Search events"><kbd>Ctrl K</kbd></div>
  <button class="btn pri" data-reg="">Student Login</button>
</div></nav>

<header class="hero" id="top"><div class="wrap">
  <span class="pill c">Pulse 2026 · Annual Inter-College Fest</span>
  <h1 style="margin-top:1rem">Where Campus Energy Meets <span class="gt">Innovation.</span></h1>
  <p>Three days, eight arenas, one campus. Hack through the night, battle on stage, build robots and book your pass before the seats run out.</p>
  <div class="cta"><a class="btn pri" href="#events">Explore Lineup</a><button class="btn gh" id="prop">Submit Event Proposal</button></div>
  <div class="cd" id="cd" aria-label="Countdown to Pulse 2026"></div>
  <div class="cdl">Until the Pulse 2026 opening ceremony · 12 Dec, 9:00 AM</div>
  <div class="stats">
    <div><b data-n="40" data-s="+">0</b><span>Events across 3 days</span></div>
    <div><b data-n="12000" data-s="+">0</b><span>Registrations so far</span></div>
    <div><b data-n="5" data-s="L+" data-p="₹">0</b><span>Prize pool</span></div>
  </div>
</div></header>

<section id="events"><div class="wrap">
  <h2>Explore <span class="gt">events</span></h2>
  <p class="sub">Filter by category, search by name or club, and check live seat availability.</p>
  <div class="fb" id="chips"></div>
  <div class="fb"><label class="sw"><input type="checkbox" id="open" checked><i></i><span id="openl">Registration open</span></label></div>
  <div class="grid" id="grid"></div>
  <p class="none" id="none" hidden>No events match. Try another category or clear the search box.</p>
</div></section>

<section id="schedule"><div class="wrap">
  <h2>Fest <span class="gt">schedule</span></h2>
  <p class="sub">Pick a day to see every slot and where it happens.</p>
  <div class="tabs" id="tabs" role="tablist"></div>
  <div class="tl" id="tl"></div>
</div></section>

<section id="board"><div class="wrap two">
  <div class="panel"><h2 style="font-size:1.4rem">Club <span class="gt">leaderboard</span></h2><p class="sub">Points from event wins and turnout.</p><div id="lb"></div></div>
  <div class="panel" id="tickets"><h2 style="font-size:1.4rem">My <span class="gt">tickets</span></h2><p class="sub">Passes saved on this device.</p><div id="tk"></div></div>
</div></section>

<footer><div class="wrap">
  <div class="fg">
    <div><h5 class="gt">CampusPulse</h5>Run by the Student Council with the Tech Club and Cultural Committee of Sri Meenakshi Institute of Technology.</div>
    <div><h5>Quick links</h5><a href="#events">Explore Events</a><a href="#schedule">Schedule</a><a href="#board">Leaderboard</a></div>
    <div><h5>Follow us</h5><a href="#top">Instagram · @campuspulse</a><a href="#top">YouTube · CampusPulse Live</a><a href="#top">LinkedIn · Pulse Fest</a></div>
    <div><h5>Helpline</h5>Fest desk: +91 98765 43210<br>Medical: +91 98765 43299<br>events@campuspulse.edu</div>
  </div>
  <div class="st"><span class="dot"></span>Dark mode active · All systems live · © 2026 CampusPulse</div>
</div></footer>

<div class="ov" id="qv"><div class="md" role="dialog" aria-modal="true"><button class="x" data-close aria-label="Close">×</button><div id="qvb"></div></div></div>
<div class="ov" id="rg"><div class="md" role="dialog" aria-modal="true"><button class="x" data-close aria-label="Close">×</button><div id="rgb"></div></div></div>
<div class="toast" id="toast" role="status"></div>

<script>
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const esc=t=>String(t).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const CATS=["All","Hackathons","Cultural & Dance","Tech Talks","Esports","Workshops","Sports"];
const EV=[
{id:1,t:"CodeStorm 24-Hour Hackathon",c:"Hackathons",o:"Tech Club · CSE Dept",d:"Day 1 · 12 Dec",v:"Innovation Lab, Block C",p:"₹1,00,000",f:0,cap:200,n:170,open:1,desc:"Teams of up to four build a working product in 24 hours around smart-campus problems. Mentors from industry judge the final demos."},
{id:2,t:"Battle of the Bands",c:"Cultural & Dance",o:"Music Society",d:"Day 2 · 13 Dec",v:"Open Air Theatre",p:"₹50,000",f:200,cap:400,n:352,open:1,desc:"Eight college bands, 20 minutes each, original songs only. Audience votes count for 30% of the score."},
{id:3,t:"RoboWars Arena",c:"Hackathons",o:"Robotics Club · ECE Dept",d:"Day 2 · 13 Dec",v:"Mechanical Workshop Yard",p:"₹75,000",f:300,cap:80,n:56,open:1,desc:"Bring a 15 kg bot and fight it out in a knockout bracket inside our steel-walled arena."},
{id:4,t:"Valorant Showdown",c:"Esports",o:"Gaming Guild",d:"Day 1 · 12 Dec",v:"Seminar Hall A",p:"₹40,000",f:250,cap:64,n:64,open:1,desc:"5v5 bracket with live shoutcasting. Registrations are full, so join the waitlist at the Gaming Guild desk."},
{id:5,t:"AI Masterclass: Building with LLMs",c:"Tech Talks",o:"AI Club · IT Dept",d:"Day 1 · 12 Dec",v:"Main Auditorium",p:"Certificate",f:0,cap:500,n:210,open:1,desc:"A hands-on session on prompts, retrieval and shipping a small chatbot, led by two alumni working at product startups."},
{id:6,t:"Pro-Show Night",c:"Cultural & Dance",o:"Cultural Committee",d:"Day 3 · 14 Dec",v:"Main Ground Stage",p:"Headline act",f:150,cap:3000,n:1980,open:1,desc:"The closing concert, with a live DJ set, a fusion dance crew and fireworks to end the fest."},
{id:7,t:"Intercollege Football Cup",c:"Sports",o:"Sports Council",d:"Day 2 · 13 Dec",v:"College Football Ground",p:"₹30,000",f:500,cap:96,n:70,open:1,desc:"Seven-a-side knockout with eight teams. Matches are 25 minutes each and referees come from the state association."},
{id:8,t:"UI/UX Design Sprint",c:"Workshops",o:"Design Society",d:"Done · 28 Sep",v:"Seminar Hall B",p:"Certificate",f:0,cap:60,n:60,open:0,desc:"The curtain-raiser workshop on Figma, user research and rapid prototyping. Recordings are on the club channel."}
];
let tickets=[];try{tickets=JSON.parse(localStorage.getItem("cp26")||"[]");const s=JSON.parse(localStorage.getItem("cp26n")||"null");if(s)s.forEach((n,i)=>EV[i].n=n)}catch(e){}
const store=()=>{try{localStorage.setItem("cp26",JSON.stringify(tickets));localStorage.setItem("cp26n",JSON.stringify(EV.map(e=>e.n)))}catch(e){}};
let cat="All";
function toast(t){const e=$("#toast");e.textContent=t;e.classList.add("on");clearTimeout(toast.h);toast.h=setTimeout(()=>e.classList.remove("on"),2600)}

/* chips */
$("#chips").innerHTML=CATS.map(c=>`<button class="chip${c==="All"?" on":""}" data-c="${c}">${c}</button>`).join("");
$("#chips").onclick=e=>{const c=e.target.dataset.c;if(!c)return;cat=c;$$(".chip").forEach(x=>x.classList.toggle("on",x.dataset.c===c));draw()};
$("#open").onchange=()=>{$("#openl").textContent=$("#open").checked?"Registration open":"Completed events";draw()};
$("#q").oninput=()=>{draw();if($("#q").value)$("#events").scrollIntoView()};
addEventListener("keydown",e=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==="k"){e.preventDefault();$("#q").focus()}if(e.key==="Escape")$$(".ov").forEach(o=>o.classList.remove("open"))});

/* cards */
function draw(){
  const q=$("#q").value.toLowerCase(),op=$("#open").checked;
  const r=EV.filter(e=>!!e.open===op&&(cat==="All"||e.c===cat)&&(e.t+e.o+e.v+e.c).toLowerCase().includes(q));
  $("#none").hidden=r.length>0;
  $("#grid").innerHTML=r.map(e=>{const pc=Math.round(e.n/e.cap*100),full=e.n>=e.cap;
  return `<article class="card"><div class="pills"><span class="pill c">${e.c}</span><span class="pill v">${e.p==="Certificate"||e.p==="Headline act"?e.p:"Prize "+e.p}</span><span class="pill i">${e.f?"₹"+e.f+" entry":"Free"}</span></div>
  <h3>${e.t}</h3><div class="org">${e.o}</div><div class="meta"><span>${e.d}</span><span>${e.v}</span></div>
  <div class="bar" role="progressbar" aria-valuenow="${pc}" aria-valuemin="0" aria-valuemax="100"><i style="width:${pc}%"></i></div>
  <div class="cap"><span>${pc}% filled</span><span>${full?"No seats left":(e.cap-e.n)+" seats left"}</span></div>
  <div class="acts"><button class="btn gh" data-q="${e.id}">Quick View</button><button class="btn pri" data-reg="${e.id}" ${!e.open||full?"disabled":""}>${!e.open?"Closed":full?"Full":"Register Now"}</button></div></article>`}).join("");
}
$("#grid").addEventListener("mousemove",e=>{const c=e.target.closest(".card");if(!c)return;const b=c.getBoundingClientRect(),x=e.clientX-b.left,y=e.clientY-b.top;
  c.style.setProperty("--mx",x+"px");c.style.setProperty("--my",y+"px");
  c.style.transform=`perspective(800px) rotateX(${((y/b.height)-.5)*-6}deg) rotateY(${((x/b.width)-.5)*6}deg)`});
$("#grid").addEventListener("mouseout",e=>{const c=e.target.closest(".card");if(c&&!c.contains(e.relatedTarget))c.style.transform=""});

/* modals */
const open=m=>$(m).classList.add("open"),close=()=>$$(".ov").forEach(o=>o.classList.remove("open"));
document.addEventListener("click",e=>{
  if(e.target.matches("[data-close]")||e.target.classList.contains("ov"))return close();
  const q=e.target.dataset.q,r=e.target.dataset.reg;
  if(q)quick(+q);
  else if(r!==undefined)regForm(+r||0);
  else if(e.target.dataset.dl)dl(e.target.dataset.dl);
});
function quick(id){const e=EV.find(x=>x.id===id);
  $("#qvb").innerHTML=`<div class="pills"><span class="pill c">${e.c}</span><span class="pill i">${e.f?"₹"+e.f+" entry":"Free"}</span></div><h3 style="margin-top:.7rem">${e.t}</h3>
  <p class="org">${e.o}</p><p style="margin:.8rem 0">${e.desc}</p><div class="meta"><span>${e.d}</span><span>${e.v}</span><span>${e.n} of ${e.cap} registered</span></div>
  <div class="acts" style="margin-top:1.2rem"><button class="btn pri" data-reg="${e.id}" ${!e.open||e.n>=e.cap?"disabled":""}>Register Now</button></div>`;
  open("#qv")}
function regForm(id){close();
  $("#rgb").innerHTML=`<h3 class="gt">Register for Pulse 2026</h3><form id="f" novalidate>
  <label>Full name<input id="fn" required minlength="3" placeholder="e.g. Aarav Krishnan"></label>
  <div class="r2"><label>Register number<input id="fr" required pattern="[0-9]{2}[A-Za-z]{2,4}[0-9]{3,4}" title="Example: 24CSE101" placeholder="24CSE101"></label>
  <label>College email<input id="fe" type="email" required placeholder="you@college.edu"></label></div>
  <div class="r2"><label>Department<select id="fd" required><option value="">Select</option><option>CSE</option><option>IT</option><option>ECE</option><option>EEE</option><option>Mechanical</option><option>Civil</option></select></label>
  <label>Year<select id="fy" required><option value="">Select</option><option>1st year</option><option>2nd year</option><option>3rd year</option><option>4th year</option></select></label></div>
  <div class="mode"><label><input type="radio" name="m" value="solo" checked>Solo</label><label><input type="radio" name="m" value="team">Team</label></div>
  <label id="tw" hidden>Team name<input id="ft" placeholder="e.g. Null Pointers"></label>
  <label>Event<select id="fv" required><option value="">Choose an event</option>${EV.filter(e=>e.open&&e.n<e.cap).map(e=>`<option value="${e.id}" ${e.id===id?"selected":""}>${e.t}</option>`).join("")}</select></label>
  <p id="er" style="color:#f87171;font-size:.85rem" role="alert"></p>
  <button class="btn pri" type="submit">Confirm registration</button></form>`;
  $$('input[name=m]').forEach(r=>r.onchange=()=>{$("#tw").hidden=r.value!=="team"||!r.checked});
  $("#f").onsubmit=submit;open("#rg")}
function submit(ev){ev.preventDefault();const f=ev.target;
  if(!f.checkValidity()){const bad=[...f.elements].find(x=>!x.checkValidity());$("#er").textContent="Check "+(bad.title||bad.previousSibling?.textContent||"the highlighted field")+".";bad.focus();return}
  const team=f.m.value==="team";if(team&&!$("#ft").value.trim()){$("#er").textContent="Enter a team name or switch to Solo.";return}
  const e=EV.find(x=>x.id==$("#fv").value);
  if(tickets.some(t=>t.eid===e.id&&t.roll.toUpperCase()===$("#fr").value.toUpperCase())){$("#er").textContent="This register number already has a pass for "+e.t+".";return}
  const t={id:"CP26-"+Math.random().toString(36).slice(2,8).toUpperCase(),eid:e.id,name:$("#fn").value.trim(),roll:$("#fr").value.trim(),dept:$("#fd").value+" · "+$("#fy").value,team:team?$("#ft").value.trim():""};
  e.n++;tickets.push(t);store();draw();tkList();
  $("#rgb").innerHTML=`<h3 class="gt">You're in! 🎉</h3><p class="org">Your digital pass for ${e.t} is ready.</p>
  <div class="pass">${qr(t.id)}<div><b>${esc(t.name)}</b><small>${esc(t.roll)} · ${esc(t.dept)}</small><small>${e.d} · ${e.v}</small><small>${t.team?"Team: "+esc(t.team):"Solo entry"}</small><small style="color:var(--cy);margin-top:.4rem">${t.id}</small></div></div>
  <div class="acts"><button class="btn pri" data-dl="${t.id}">Download ticket</button><button class="btn gh" data-close>Done</button></div>`;
  toast("Registered for "+e.t);confetti()}

/* QR (decorative mock) */
function qr(seed,raw){let h=0;for(const c of seed)h=(h*31+c.charCodeAt(0))>>>0;const rnd=()=>(h=(h*1664525+1013904223)>>>0)/4294967296;
  const N=21,fin=(x,y)=>[[0,0],[N-7,0],[0,N-7]].some(([a,b])=>x>=a&&x<a+7&&y>=b&&y<b+7);let s="";
  for(let y=0;y<N;y++)for(let x=0;x<N;x++){let on;if(fin(x,y)){const [a,b]=[[0,0],[N-7,0],[0,N-7]].find(([a,b])=>x>=a&&x<a+7&&y>=b&&y<b+7),dx=x-a,dy=y-b;on=dx%6===0||dy%6===0||(dx>1&&dx<5&&dy>1&&dy<5)}else on=rnd()>.5;
  if(on)s+=`<rect x="${x}" y="${y}" width="1" height="1"/>`}
  return raw?s:`<svg viewBox="0 0 21 21" fill="#0a0b10" aria-label="Pass QR code">${s}</svg>`}
function dl(id){const t=tickets.find(x=>x.id===id),e=EV.find(x=>x.id===t.eid);
  const svg=`<svg xmlns="http://www.w3.org/2000/svg" width="640" height="260" viewBox="0 0 640 260"><rect width="640" height="260" rx="22" fill="#12131d" stroke="#6366f1" stroke-width="3"/><text x="30" y="52" fill="#22d3ee" font-family="Arial" font-size="16" font-weight="bold">CAMPUSPULSE · PULSE 2026</text><text x="30" y="100" fill="#fff" font-family="Arial" font-size="26" font-weight="bold">${esc(e.t)}</text><text x="30" y="140" fill="#e8eaf6" font-family="Arial" font-size="20">${esc(t.name)}</text><text x="30" y="168" fill="#8b90ad" font-family="Arial" font-size="15">${esc(t.roll)} · ${esc(t.dept)}</text><text x="30" y="196" fill="#8b90ad" font-family="Arial" font-size="15">${e.d} · ${esc(e.v)}</text><text x="30" y="232" fill="#a855f7" font-family="Arial" font-size="16" font-weight="bold">${t.id}</text><rect x="440" y="40" width="170" height="170" rx="10" fill="#fff"/><g transform="translate(450 50) scale(7.6)" fill="#0a0b10">${qr(t.id,1)}</g></svg>`;
  const a=document.createElement("a");a.href=URL.createObjectURL(new Blob([svg],{type:"image/svg+xml"}));a.download=t.id+".svg";a.click();toast("Ticket downloaded")}
function tkList(){$("#tk").innerHTML=tickets.length?tickets.map(t=>{const e=EV.find(x=>x.id===t.eid);return `<div class="tk"><span><b>${e.t}</b><br><small class="org">${t.id} · ${esc(t.name)}</small></span><button class="btn gh" style="padding:.4rem .8rem" data-dl="${t.id}">Download</button></div>`}).join(""):`<p class="none" style="padding:0">No tickets yet. Register for an event to get your first pass.</p>`}

/* schedule */
const SC={"Day 1 · 12 Dec":[["9:00 AM","Opening Ceremony & Keynote","Main Auditorium"],["12:00 PM","CodeStorm kickoff and Valorant group rounds","Innovation Lab / Seminar Hall A"],["6:00 PM","AI Masterclass: Building with LLMs","Main Auditorium"]],
"Day 2 · 13 Dec":[["10:00 AM","RoboWars qualifiers and Football Cup round one","Workshop Yard / Football Ground"],["1:30 PM","Dance showdown, regional crews","Open Air Theatre"],["7:00 PM","Battle of the Bands","Open Air Theatre"]],
"Day 3 · 14 Dec":[["9:30 AM","CodeStorm final demos and judging","Innovation Lab"],["2:00 PM","Finals: RoboWars, Football and Valorant","Arena, Ground, Hall A"],["7:30 PM","Prize ceremony & Pro-Show Night","Main Ground Stage"]]};
