$("#tabs").innerHTML=days.map((d,i)=>`<button class="chip${i?"":" on"}" role="tab" data-d="${d}">${d.split(" · ")[0]}</button>`).join("");
function day(d){$$("#tabs .chip").forEach(c=>c.classList.toggle("on",c.dataset.d===d));
  $("#tl").innerHTML=SC[d].map(s=>`<div class="slot"><time>${s[0]}</time><h4>${s[1]}</h4><div class="org">${s[2]}</div></div>`).join("")}
